{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-willow-well-site",
  "main": "worker.js",
  "compatibility_date": "2026-05-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]  ,
  "kv_namespaces": [
    {
      "binding": "WW_DATA",
      "id": "9486d01f060a47a5a75d489eb9d027a6"
    }
  ]
}
